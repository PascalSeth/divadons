// ============================================================
// Diva & Dons — Prisma v7 Schema
// ============================================================
// Conventions:
//   • camelCase fields (Prisma standard), snake_case mapped to DB
//   • All IDs are String @id @default(uuid()) unless natural key
//   • Prices stored as Float (map to DECIMAL in DB via @db.Decimal)
//   • Enums for all status/role fields
//   • Explicit @relation names on all relations
//   • @@map() used to keep DB table names snake_case
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// ENUMS
// ============================================================

enum ProductStatus {
  active
  inactive
  out_of_stock
}

enum OrderStatus {
  pending
  processing
  shipped
  delivered
  cancelled
}

enum UserRole {
  admin
  editor
  costumer
}

enum BlogStatus {
  draft
  published
}

enum ContentBlockType {
  hero_slide
  testimonial
  brand_value
  shipping_info
}

// Supported currencies for pricing and orders across the app.
// Use ISO 4217 currency codes.
enum Currency {
  USD
  EUR
  GBP
  NGN
}

enum DiscountType {
  percentage
  fixed
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}


// ============================================================
// USERS  (admin panel access — NOT the same as customers)
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // bcrypt/argon2 hash — never plaintext
  name          String?
  image         String?
  role          UserRole  @default(costumer)
  avatar        String?   // image URL
  lastLogin     DateTime? @map("last_login")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth Account model
model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}


// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id           String    @id                  // 'ankara' | 'kente' | 'dashiki' | 'beauty' | 'accessories'
  name         String
  subtitle     String?
  description  String?
  color        String?                        // hex colour for UI theming
  gradient     String?                        // CSS/Tailwind gradient class
  image        String?                        // Supabase object path or full URL
  productCount Int       @default(0) @map("product_count")  // cached count — update via trigger or app logic
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  metaTitle    String?   @map("meta_title")
  metaDescription String? @map("meta_description")

  products     Product[]
  collections  CollectionCategory[]

  @@map("categories")
}


// ============================================================
// COLLECTIONS  (curated groupings — many-to-many with products)
// ============================================================

model Collection {
  id          String   @id                   // URL slug e.g. 'summer-2025'
  name        String
  subtitle    String?
  description String?
  color       String?
  gradient    String?
  image       String?                        // Supabase object path or full URL
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    CollectionProduct[]
  categories  CollectionCategory[]

  @@map("collections")
}


// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String        @id @default(uuid())
  name        String
  categoryId  String        @map("category_id")
  subcategory String?                          // beauty only: 'skincare' | 'makeup' | 'haircare' | 'bodycare'
  price       Decimal       @db.Decimal(10, 2)
  currency    Currency      @default(USD)     // product price currency (ISO 4217)
  description String?
  images      String[]                         // array of image URLs
  color       String?
  sizes       String[]                         // ['S','M','L','XL'] or ['30ml','50ml']
  featured    Boolean       @default(false)
  bestseller  Boolean       @default(false)    // beauty products
  vegan       Boolean       @default(false)    // beauty products
  concern     String?                          // skincare: 'Anti-Aging' | 'Acne' | 'Dryness' etc.
  stock       Int           @default(0)
  status      ProductStatus @default(active)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")

  // Relations
  category    Category            @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  collections CollectionProduct[]
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  reviews     Review[]

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([bestseller])
  @@map("products")
}


// ============================================================
// COLLECTION <-> PRODUCT  (junction table)
// ============================================================

model CollectionProduct {
  collectionId String   @map("collection_id")
  productId    String   @map("product_id")
  sortOrder    Int      @default(0) @map("sort_order")

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@map("collection_products")
}


// ============================================================
// PRODUCT VARIANTS  (granular inventory control)
// ============================================================

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  sku           String   @unique
  size          String?
  color         String?
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2) @map("price_override")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}


// ============================================================
// COLLECTION <-> CATEGORY  (junction table)
// ============================================================

model CollectionCategory {
  collectionId String   @map("collection_id")
  categoryId   String   @map("category_id")
  sortOrder    Int      @default(0) @map("sort_order")

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([collectionId, categoryId])
  @@map("collection_categories")
}


// ============================================================
// CUSTOMERS  (storefront shoppers — separate from admin Users)
// ============================================================

model Customer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  addresses    CustomerAddress[]
  orders       Order[]
  wishlist     WishlistItem[]
  notifications Notification[]

  @@index([email])
  @@map("customers")
}


// ============================================================
// CUSTOMER ADDRESSES
// ============================================================

model CustomerAddress {
  id          String   @id @default(uuid())
  customerId  String   @map("customer_id")
  street      String
  city        String
  state       String?
  country     String
  postalCode  String?  @map("postal_code")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}


// ============================================================
// ORDERS
// ============================================================

model Order {
  id            String      @id                // '#ORD-001' — app-generated
  customerId    String      @map("customer_id")
  total         Decimal     @db.Decimal(10, 2)
  currency      Currency    @default(USD)     // currency for this order (snapshot)
  status        OrderStatus @default(pending)
  paymentMethod String?     @map("payment_method")

  // Shipping address — snapshotted at order time, NOT a FK.
  // This protects historical accuracy if the customer later changes address.
  shippingStreet      String?  @map("shipping_street")
  shippingCity        String?  @map("shipping_city")
  shippingState       String?  @map("shipping_state")
  shippingCountry     String?  @map("shipping_country")
  shippingPostalCode  String?  @map("shipping_postal_code")

  // Billing address — same snapshot rationale
  billingStreet       String?  @map("billing_street")
  billingCity         String?  @map("billing_city")
  billingState        String?  @map("billing_state")
  billingCountry      String?  @map("billing_country")
  billingPostalCode   String?  @map("billing_postal_code")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Tracking & Carrier Info
  trackingId  String?  @map("tracking_id")
  carrierName String?  @map("carrier_name")  // FedEx, DHL, Internal Driver
  shippedAt   DateTime? @map("shipped_at")

  // Relations
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  transactions PaymentTransaction[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}


// ============================================================
// STRIPE PAYMENT TRANSACTIONS
// ============================================================

model PaymentTransaction {
  id                     String        @id @default(uuid())
  orderId                String        @map("order_id")
  stripePaymentIntentId  String        @unique @map("stripe_payment_intent_id")
  stripeCustomerId       String?       @map("stripe_customer_id")
  amount                 Decimal       @db.Decimal(10, 2)
  currency               Currency      @default(USD)
  status                 PaymentStatus @default(pending)
  createdAt              DateTime      @default(now()) @map("created_at")

  order                  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stripePaymentIntentId])
  @@map("payment_transactions")
}


// ============================================================
// ORDER ITEMS
// ============================================================

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  productId   String?  @map("product_id")    // nullable — product may be deleted later
  productName String   @map("product_name")  // snapshot: preserves name even if product is deleted
  quantity    Int      @default(1)
  price       Decimal  @db.Decimal(10, 2)    // unit price snapshot at purchase time
  size        String?
  color       String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}


// ============================================================
// BLOG POSTS
// ============================================================

model BlogPost {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  content        String                          // markdown or HTML
  excerpt        String?
  category       String                          // 'Fashion' | 'Beauty'
  featuredImage  String?    @map("featured_image")
  author         String
  tags           String[]                        // e.g. ['ankara', 'summer', 'skincare']
  status         BlogStatus @default(draft)
  publishedAt    DateTime?  @map("published_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  metaTitle       String?   @map("meta_title")
  metaDescription String?   @map("meta_description")

  @@index([slug])
  @@index([status])
  @@index([category])
  @@map("blog_posts")
}


// ============================================================
// WISHLISTS  (customer saves — many-to-many via junction)
// ============================================================

model WishlistItem {
  customerId  String   @map("customer_id")
  productId   String   @map("product_id")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([customerId, productId])
  @@map("wishlist_items")
}


// ============================================================
// PRODUCT REVIEWS
// ============================================================

model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  customerName String @map("customer_name")  // public display name
  email     String                            // for contact but not publicly shown
  rating    Int                               // 1-5 stars
  title     String
  comment   String
  verified  Boolean  @default(false)          // verified purchase flag
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([rating])
  @@map("reviews")
}


// ============================================================
// NEWSLETTER SUBSCRIPTIONS
// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  order_status
  system
  promotion
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType @default(order_status)
  isRead    Boolean          @default(false) @map("is_read")
  orderId   String?          @map("order_id")
  isAdmin   Boolean          @default(false) @map("is_admin")
  
  // Optional link to customer (if null, it's a global/admin notification)
  customerId String?          @map("customer_id")
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([isRead])
  @@index([isAdmin])
  @@map("notifications")
}

// ============================================================

model NewsletterSubscription {
  id          String   @id @default(uuid())
  email       String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")
  active      Boolean  @default(true)

  @@map("newsletter_subscriptions")
}


// ============================================================
// HOMEPAGE CONTENT BLOCKS  (hero slides, testimonials, etc.)
//
// Using a flexible JSON-column approach rather than rigid tables.
// Each row is one piece of managed content (a slide, a testimonial…).
// The `data` column holds the shape-specific payload as JSON.
//
// Hero slide data:    { name, category, price, image, tagline }
// Testimonial data:   { name, location, rating, comment, image }
// Brand value data:   { icon, title, description }
// Shipping info data: { icon, label, detail }
// ============================================================

model ContentBlock {
  id        String           @id @default(uuid())
  type      ContentBlockType
  sortOrder Int              @default(0) @map("sort_order")
  active    Boolean          @default(true)
  data      Json                                   // shape varies by type — see comments above
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([type, active])
  @@map("content_blocks")
}


// ============================================================
// ANNOUNCEMENTS  (banners & popups for storefront)
// ============================================================

enum AnnouncementType {
  banner
  popup
}

model Announcement {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      AnnouncementType @default(banner)
  bgColor   String           @default("#1a1a1a") @map("bg_color")
  textColor String           @default("#ffffff") @map("text_color")
  linkText  String?          @map("link_text")
  linkUrl   String?          @map("link_url")
  active    Boolean          @default(true)
  startDate DateTime?        @map("start_date")
  endDate   DateTime?        @map("end_date")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([active, type])
  @@map("announcements")
}


// ============================================================
// EMAIL CAMPAIGNS  (sent to newsletter subscribers)
// ============================================================

enum EmailCampaignStatus {
  pending
  sent
  failed
}

model EmailCampaign {
  id             String              @id @default(uuid())
  subject        String
  content        String              @db.Text
  recipientCount Int                 @default(0) @map("recipient_count")
  status         EmailCampaignStatus @default(pending)
  sentAt         DateTime?           @map("sent_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@map("email_campaigns")
}


// ============================================================
// COUPONS & DISCOUNTS
// ============================================================

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @map("discount_type")
  value         Decimal      @db.Decimal(10, 2)
  minSpend      Decimal?     @db.Decimal(10, 2) @map("min_spend")
  usageLimit    Int?         @map("usage_limit")
  usedCount     Int          @default(0) @map("used_count")
  expiresAt     DateTime?    @map("expires_at")
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@map("coupons")
}


// Global settings for the storefront / admin
// Stored as a simple table; application enforces singleton semantics.
model Setting {
  id             String   @id @default(uuid())
  siteName       String   @default("Diva & Dons") @map("site_name")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  supportEmail   String?  @map("support_email")
  supportPhone   String?  @map("support_phone")
  storeAddress   String?  @map("store_address")
  currency       Currency @default(USD)
  socialLinks    Json?    @map("social_links")    // { icon, platform, url }
  metaTitle      String?  @map("meta_title")
  metaDescription String? @map("meta_description")
  
  // Stripe Configuration
  stripePublishableKey String? @map("stripe_publishable_key")
  stripeSecretKey      String? @map("stripe_secret_key")
  stripeWebhookSecret  String? @map("stripe_webhook_secret")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
