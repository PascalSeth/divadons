"activeProvider\": \"postgresql\",\n  \"inlineSchema\": \"// ============================================================\\n// Diva & Dons — Prisma v7 Schema\\n// ============================================================\\n// Conventions:\\n//   • camelCase fields (Prisma standard), snake_case mapped to DB\\n//   • All IDs are String @id @default(uuid()) unless natural key\\n//   • Prices stored as Float (map to DECIMAL in DB via @db.Decimal)\\n//   • Enums for all status/role fields\\n//   • Explicit @relation names on all relations\\n//   • @@map() used to keep DB table names snake_case\\n// ============================================================\\n\\ngenerator client {\\n  provider = \\\"prisma-client-js\\\"\\n  output   = \\\"../app/generated/prisma\\\"\\n}\\n\\ndatasource db {\\n  provider = \\\"postgresql\\\"\\n}\\n\\n// ============================================================\\n// ENUMS\\n// ============================================================\\n\\nenum ProductStatus {\\n  active\\n  inactive\\n  out_of_stock\\n}\\n\\nenum OrderStatus {\\n  pending\\n  processing\\n  shipped\\n  delivered\\n  cancelled\\n}\\n\\nenum UserRole {\\n  admin\\n  editor\\n  costumer\\n}\\n\\nenum BlogStatus {\\n  draft\\n  published\\n}\\n\\nenum ContentBlockType {\\n  hero_slide\\n  testimonial\\n  brand_value\\n  shipping_info\\n}\\n\\n// Supported currencies for pricing and orders across the app.\\n// Use ISO 4217 currency codes.\\nenum Currency {\\n  USD\\n  EUR\\n  GBP\\n  NGN\\n}\\n\\nenum DiscountType {\\n  percentage\\n  fixed\\n}\\n\\nenum PaymentStatus {\\n  pending\\n  succeeded\\n  failed\\n  refunded\\n}\\n\\n// ============================================================\\n// USERS  (admin panel access — NOT the same as customers)\\n// ============================================================\\n\\nmodel User {\\n  id            String    @id @default(uuid())\\n  email         String    @unique\\n  emailVerified DateTime? @map(\\\"email_verified\\\")\\n  password      String? // bcrypt/argon2 hash — never plaintext\\n  name          String?\\n  image         String?\\n  role          UserRole  @default(costumer)\\n  avatar        String? // image URL\\n  lastLogin     DateTime? @map(\\\"last_login\\\")\\n  createdAt     DateTime  @default(now()) @map(\\\"created_at\\\")\\n  updatedAt     DateTime  @updatedAt @map(\\\"updated_at\\\")\\n\\n  // NextAuth relations\\n  accounts Account[]\\n  sessions Session[]\\n\\n  @@map(\\\"users\\\")\\n}\\n\\n// NextAuth Account model\\nmodel Account {\\n  id                String  @id @default(cuid())\\n  userId            String  @map(\\\"user_id\\\")\\n  type              String\\n  provider          String\\n  providerAccountId String  @map(\\\"provider_account_id\\\")\\n  refresh_token     String? @db.Text\\n  access_token      String? @db.Text\\n  expires_at        Int?\\n  token_type        String?\\n  scope             String?\\n  id_token          String? @db.Text\\n  session_state     String?\\n\\n  user User @relation(fields: [userId], references: [id], onDelete: Cascade)\\n\\n  @@unique([provider, providerAccountId])\\n  @@map(\\\"accounts\\\")\\n}\\n\\n// NextAuth Session model\\nmodel Session {\\n  id           String   @id @default(cuid())\\n  sessionToken String   @unique @map(\\\"session_token\\\")\\n  userId       String   @map(\\\"user_id\\\")\\n  expires      DateTime\\n  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)\\n\\n  @@map(\\\"sessions\\\")\\n}\\n\\n// NextAuth VerificationToken model\\nmodel VerificationToken {\\n  identifier String\\n  token      String   @unique\\n  expires    DateTime\\n\\n  @@unique([identifier, token])\\n  @@map(\\\"verification_tokens\\\")\\n}\\n\\n// ============================================================\\n// CATEGORIES\\n// ============================================================\\n\\nmodel Category {\\n  id           String   @id // 'ankara' | 'kente' | 'dashiki' | 'beauty' | 'accessories'\\n  name         String\\n  subtitle     String?\\n  description  String?\\n  color        String? // hex colour for UI theming\\n  gradient     String? // CSS/Tailwind gradient class\\n  image        String? // Supabase object path or full URL\\n  productCount Int      @default(0) @map(\\\"product_count\\\") // cached count — update via trigger or app logic\\n  createdAt    DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt    DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  metaTitle       String? @map(\\\"meta_title\\\")\\n  metaDescription String? @map(\\\"meta_description\\\")\\n\\n  products    Product[]\\n  collections CollectionCategory[]\\n\\n  @@map(\\\"categories\\\")\\n}\\n\\n// ============================================================\\n// COLLECTIONS  (curated groupings — many-to-many with products)\\n// ============================================================\\n\\nmodel Collection {\\n  id          String   @id // URL slug e.g. 'summer-2025'\\n  name        String\\n  subtitle    String?\\n  description String?\\n  color       String?\\n  gradient    String?\\n  image       String? // Supabase object path or full URL\\n  createdAt   DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt   DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  products   CollectionProduct[]\\n  categories CollectionCategory[]\\n\\n  @@map(\\\"collections\\\")\\n}\\n\\n// ============================================================\\n// PRODUCTS\\n// ============================================================\\n\\nmodel Product {\\n  id          String        @id @default(uuid())\\n  name        String\\n  categoryId  String        @map(\\\"category_id\\\")\\n  subcategory String? // beauty only: 'skincare' | 'makeup' | 'haircare' | 'bodycare'\\n  price       Decimal       @db.Decimal(10, 2)\\n  currency    Currency      @default(USD) // product price currency (ISO 4217)\\n  description String?\\n  images      String[] // array of image URLs\\n  color       String?\\n  sizes       String[] // ['S','M','L','XL'] or ['30ml','50ml']\\n  featured    Boolean       @default(false)\\n  bestseller  Boolean       @default(false) // beauty products\\n  vegan       Boolean       @default(false) // beauty products\\n  concern     String? // skincare: 'Anti-Aging' | 'Acne' | 'Dryness' etc.\\n  stock       Int           @default(0)\\n  status      ProductStatus @default(active)\\n  createdAt   DateTime      @default(now()) @map(\\\"created_at\\\")\\n  updatedAt   DateTime      @updatedAt @map(\\\"updated_at\\\")\\n\\n  metaTitle       String? @map(\\\"meta_title\\\")\\n  metaDescription String? @map(\\\"meta_description\\\")\\n\\n  // Relations\\n  category      Category            @relation(fields: [categoryId], references: [id])\\n  variants      ProductVariant[]\\n  collections   CollectionProduct[]\\n  orderItems    OrderItem[]\\n  wishlistItems WishlistItem[]\\n  reviews       Review[]\\n\\n  @@index([categoryId])\\n  @@index([status])\\n  @@index([featured])\\n  @@index([bestseller])\\n  @@map(\\\"products\\\")\\n}\\n\\n// ============================================================\\n// COLLECTION <-> PRODUCT  (junction table)\\n// ============================================================\\n\\nmodel CollectionProduct {\\n  collectionId String @map(\\\"collection_id\\\")\\n  productId    String @map(\\\"product_id\\\")\\n  sortOrder    Int    @default(0) @map(\\\"sort_order\\\")\\n\\n  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)\\n  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)\\n\\n  @@id([collectionId, productId])\\n  @@map(\\\"collection_products\\\")\\n}\\n\\n// ============================================================\\n// PRODUCT VARIANTS  (granular inventory control)\\n// ============================================================\\n\\nmodel ProductVariant {\\n  id            String   @id @default(uuid())\\n  productId     String   @map(\\\"product_id\\\")\\n  sku           String   @unique\\n  size          String?\\n  color         String?\\n  stock         Int      @default(0)\\n  priceOverride Decimal? @map(\\\"price_override\\\") @db.Decimal(10, 2)\\n\\n  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)\\n\\n  @@index([productId])\\n  @@map(\\\"product_variants\\\")\\n}\\n\\n// ============================================================\\n// COLLECTION <-> CATEGORY  (junction table)\\n// ============================================================\\n\\nmodel CollectionCategory {\\n  collectionId String @map(\\\"collection_id\\\")\\n  categoryId   String @map(\\\"category_id\\\")\\n  sortOrder    Int    @default(0) @map(\\\"sort_order\\\")\\n\\n  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)\\n  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)\\n\\n  @@id([collectionId, categoryId])\\n  @@map(\\\"collection_categories\\\")\\n}\\n\\n// ============================================================\\n// CUSTOMERS  (storefront shoppers — separate from admin Users)\\n// ============================================================\\n\\nmodel Customer {\\n  id        String   @id @default(uuid())\\n  name      String\\n  email     String   @unique\\n  phone     String?\\n  createdAt DateTime @default(now()) @map(\\\"created_at\\\")\\n\\n  // Relations\\n  addresses     CustomerAddress[]\\n  orders        Order[]\\n  wishlist      WishlistItem[]\\n  notifications Notification[]\\n\\n  @@index([email])\\n  @@map(\\\"customers\\\")\\n}\\n\\n// ============================================================\\n// CUSTOMER ADDRESSES\\n// ============================================================\\n\\nmodel CustomerAddress {\\n  id         String   @id @default(uuid())\\n  customerId String   @map(\\\"customer_id\\\")\\n  street     String\\n  city       String\\n  state      String?\\n  country    String\\n  postalCode String?  @map(\\\"postal_code\\\")\\n  isDefault  Boolean  @default(false) @map(\\\"is_default\\\")\\n  createdAt  DateTime @default(now()) @map(\\\"created_at\\\")\\n\\n  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)\\n\\n  @@index([customerId])\\n  @@map(\\\"customer_addresses\\\")\\n}\\n\\n// ============================================================\\n// ORDERS\\n// ============================================================\\n\\nmodel Order {\\n  id            String      @id // '#ORD-001' — app-generated\\n  customerId    String      @map(\\\"customer_id\\\")\\n  total         Decimal     @db.Decimal(10, 2)\\n  currency      Currency    @default(USD) // currency for this order (snapshot)\\n  status        OrderStatus @default(pending)\\n  paymentMethod String?     @map(\\\"payment_method\\\")\\n\\n  // Shipping address — snapshotted at order time, NOT a FK.\\n  // This protects historical accuracy if the customer later changes address.\\n  shippingStreet     String? @map(\\\"shipping_street\\\")\\n  shippingCity       String? @map(\\\"shipping_city\\\")\\n  shippingState      String? @map(\\\"shipping_state\\\")\\n  shippingCountry    String? @map(\\\"shipping_country\\\")\\n  shippingPostalCode String? @map(\\\"shipping_postal_code\\\")\\n\\n  // Billing address — same snapshot rationale\\n  billingStreet     String? @map(\\\"billing_street\\\")\\n  billingCity       String? @map(\\\"billing_city\\\")\\n  billingState      String? @map(\\\"billing_state\\\")\\n  billingCountry    String? @map(\\\"billing_country\\\")\\n  billingPostalCode String? @map(\\\"billing_postal_code\\\")\\n\\n  createdAt DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  // Tracking & Carrier Info\\n  trackingId  String?   @map(\\\"tracking_id\\\")\\n  carrierName String?   @map(\\\"carrier_name\\\") // FedEx, DHL, Internal Driver\\n  shippedAt   DateTime? @map(\\\"shipped_at\\\")\\n\\n  // Relations\\n  customer     Customer             @relation(fields: [customerId], references: [id])\\n  items        OrderItem[]\\n  transactions PaymentTransaction[]\\n\\n  @@index([customerId])\\n  @@index([status])\\n  @@index([createdAt(sort: Desc)])\\n  @@map(\\\"orders\\\")\\n}\\n\\n// ============================================================\\n// STRIPE PAYMENT TRANSACTIONS\\n// ============================================================\\n\\nmodel PaymentTransaction {\\n  id                    String        @id @default(uuid())\\n  orderId               String        @map(\\\"order_id\\\")\\n  stripePaymentIntentId String        @unique @map(\\\"stripe_payment_intent_id\\\")\\n  stripeCustomerId      String?       @map(\\\"stripe_customer_id\\\")\\n  amount                Decimal       @db.Decimal(10, 2)\\n  currency              Currency      @default(USD)\\n  status                PaymentStatus @default(pending)\\n  createdAt             DateTime      @default(now()) @map(\\\"created_at\\\")\\n\\n  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)\\n\\n  @@index([orderId])\\n  @@index([stripePaymentIntentId])\\n  @@map(\\\"payment_transactions\\\")\\n}\\n\\n// ============================================================\\n// ORDER ITEMS\\n// ============================================================\\n\\nmodel OrderItem {\\n  id          String  @id @default(uuid())\\n  orderId     String  @map(\\\"order_id\\\")\\n  productId   String? @map(\\\"product_id\\\") // nullable — product may be deleted later\\n  productName String  @map(\\\"product_name\\\") // snapshot: preserves name even if product is deleted\\n  quantity    Int     @default(1)\\n  price       Decimal @db.Decimal(10, 2) // unit price snapshot at purchase time\\n  size        String?\\n  color       String?\\n\\n  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)\\n  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)\\n\\n  @@index([orderId])\\n  @@index([productId])\\n  @@map(\\\"order_items\\\")\\n}\\n\\n// ============================================================\\n// BLOG POSTS\\n// ============================================================\\n\\nmodel BlogPost {\\n  id            String     @id @default(uuid())\\n  title         String\\n  slug          String     @unique\\n  content       String // markdown or HTML\\n  excerpt       String?\\n  category      String // 'Fashion' | 'Beauty'\\n  featuredImage String?    @map(\\\"featured_image\\\")\\n  author        String\\n  tags          String[] // e.g. ['ankara', 'summer', 'skincare']\\n  status        BlogStatus @default(draft)\\n  publishedAt   DateTime?  @map(\\\"published_at\\\")\\n  createdAt     DateTime   @default(now()) @map(\\\"created_at\\\")\\n  updatedAt     DateTime   @updatedAt @map(\\\"updated_at\\\")\\n\\n  metaTitle       String? @map(\\\"meta_title\\\")\\n  metaDescription String? @map(\\\"meta_description\\\")\\n\\n  @@index([slug])\\n  @@index([status])\\n  @@index([category])\\n  @@map(\\\"blog_posts\\\")\\n}\\n\\n// ============================================================\\n// WISHLISTS  (customer saves — many-to-many via junction)\\n// ============================================================\\n\\nmodel WishlistItem {\\n  customerId String   @map(\\\"customer_id\\\")\\n  productId  String   @map(\\\"product_id\\\")\\n  createdAt  DateTime @default(now()) @map(\\\"created_at\\\")\\n\\n  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)\\n  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)\\n\\n  @@id([customerId, productId])\\n  @@map(\\\"wishlist_items\\\")\\n}\\n\\n// ============================================================\\n// PRODUCT REVIEWS\\n// ============================================================\\n\\nmodel Review {\\n  id           String   @id @default(uuid())\\n  productId    String   @map(\\\"product_id\\\")\\n  customerName String   @map(\\\"customer_name\\\") // public display name\\n  email        String // for contact but not publicly shown\\n  rating       Int // 1-5 stars\\n  title        String\\n  comment      String\\n  verified     Boolean  @default(false) // verified purchase flag\\n  createdAt    DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt    DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)\\n\\n  @@index([productId])\\n  @@index([rating])\\n  @@map(\\\"reviews\\\")\\n}\\n\\n// ============================================================\\n// NEWSLETTER SUBSCRIPTIONS\\n// ============================================================\\n// NOTIFICATIONS\\n// ============================================================\\n\\nenum NotificationType {\\n  order_status\\n  system\\n  promotion\\n}\\n\\nmodel Notification {\\n  id      String           @id @default(uuid())\\n  title   String\\n  message String\\n  type    NotificationType @default(order_status)\\n  isRead  Boolean          @default(false) @map(\\\"is_read\\\")\\n  orderId String?          @map(\\\"order_id\\\")\\n  isAdmin Boolean          @default(false) @map(\\\"is_admin\\\")\\n\\n  // Optional link to customer (if null, it's a global/admin notification)\\n  customerId String?   @map(\\\"customer_id\\\")\\n  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)\\n\\n  createdAt DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  @@index([customerId])\\n  @@index([isRead])\\n  @@index([isAdmin])\\n  @@map(\\\"notifications\\\")\\n}\\n\\n// ============================================================\\n\\nmodel NewsletterSubscription {\\n  id           String   @id @default(uuid())\\n  email        String   @unique\\n  subscribedAt DateTime @default(now()) @map(\\\"subscribed_at\\\")\\n  active       Boolean  @default(true)\\n\\n  @@map(\\\"newsletter_subscriptions\\\")\\n}\\n\\n// ============================================================\\n// HOMEPAGE CONTENT BLOCKS  (hero slides, testimonials, etc.)\\n//\\n// Using a flexible JSON-column approach rather than rigid tables.\\n// Each row is one piece of managed content (a slide, a testimonial…).\\n// The `data` column holds the shape-specific payload as JSON.\\n//\\n// Hero slide data:    { name, category, price, image, tagline }\\n// Testimonial data:   { name, location, rating, comment, image }\\n// Brand value data:   { icon, title, description }\\n// Shipping info data: { icon, label, detail }\\n// ============================================================\\n\\nmodel ContentBlock {\\n  id        String           @id @default(uuid())\\n  type      ContentBlockType\\n  sortOrder Int              @default(0) @map(\\\"sort_order\\\")\\n  active    Boolean          @default(true)\\n  data      Json // shape varies by type — see comments above\\n  createdAt DateTime         @default(now()) @map(\\\"created_at\\\")\\n  updatedAt DateTime         @updatedAt @map(\\\"updated_at\\\")\\n\\n  @@index([type, active])\\n  @@map(\\\"content_blocks\\\")\\n}\\n\\n// ============================================================\\n// ANNOUNCEMENTS  (banners & popups for storefront)\\n// ============================================================\\n\\nenum AnnouncementType {\\n  banner\\n  popup\\n}\\n\\nmodel Announcement {\\n  id        String           @id @default(uuid())\\n  title     String\\n  message   String\\n  type      AnnouncementType @default(banner)\\n  bgColor   String           @default(\\\"#1a1a1a\\\") @map(\\\"bg_color\\\")\\n  textColor String           @default(\\\"#ffffff\\\") @map(\\\"text_color\\\")\\n  linkText  String?          @map(\\\"link_text\\\")\\n  linkUrl   String?          @map(\\\"link_url\\\")\\n  active    Boolean          @default(true)\\n  startDate DateTime?        @map(\\\"start_date\\\")\\n  endDate   DateTime?        @map(\\\"end_date\\\")\\n  createdAt DateTime         @default(now()) @map(\\\"created_at\\\")\\n  updatedAt DateTime         @updatedAt @map(\\\"updated_at\\\")\\n\\n  @@index([active, type])\\n  @@map(\\\"announcements\\\")\\n}\\n\\n// ============================================================\\n// EMAIL CAMPAIGNS  (sent to newsletter subscribers)\\n// ============================================================\\n\\nenum EmailCampaignStatus {\\n  pending\\n  sent\\n  failed\\n}\\n\\nmodel EmailCampaign {\\n  id             String              @id @default(uuid())\\n  subject        String\\n  content        String              @db.Text\\n  recipientCount Int                 @default(0) @map(\\\"recipient_count\\\")\\n  status         EmailCampaignStatus @default(pending)\\n  sentAt         DateTime?           @map(\\\"sent_at\\\")\\n  createdAt      DateTime            @default(now()) @map(\\\"created_at\\\")\\n  updatedAt      DateTime            @updatedAt @map(\\\"updated_at\\\")\\n\\n  @@index([status])\\n  @@map(\\\"email_campaigns\\\")\\n}\\n\\n// ============================================================\\n// COUPONS & DISCOUNTS\\n// ============================================================\\n\\nmodel Coupon {\\n  id           String       @id @default(uuid())\\n  code         String       @unique\\n  description  String?\\n  discountType DiscountType @map(\\\"discount_type\\\")\\n  value        Decimal      @db.Decimal(10, 2)\\n  minSpend     Decimal?     @map(\\\"min_spend\\\") @db.Decimal(10, 2)\\n  usageLimit   Int?         @map(\\\"usage_limit\\\")\\n  usedCount    Int          @default(0) @map(\\\"used_count\\\")\\n  expiresAt    DateTime?    @map(\\\"expires_at\\\")\\n  active       Boolean      @default(true)\\n  createdAt    DateTime     @default(now()) @map(\\\"created_at\\\")\\n\\n  @@map(\\\"coupons\\\")\\n}\\n\\n// Global settings for the storefront / admin\\n// Stored as a simple table; application enforces singleton semantics.\\nmodel Setting {\\n  id              String   @id @default(uuid())\\n  siteName        String   @default(\\\"Diva & Dons\\\") @map(\\\"site_name\\\")\\n  logoUrl         String?  @map(\\\"logo_url\\\")\\n  faviconUrl      String?  @map(\\\"favicon_url\\\")\\n  supportEmail    String?  @map(\\\"support_email\\\")\\n  supportPhone    String?  @map(\\\"support_phone\\\")\\n  storeAddress    String?  @map(\\\"store_address\\\")\\n  currency        Currency @default(USD)\\n  socialLinks     Json?    @map(\\\"social_links\\\") // { icon, platform, url }\\n  metaTitle       String?  @map(\\\"meta_title\\\")\\n  metaDescription String?  @map(\\\"meta_description\\\")\\n\\n  // Stripe Configuration\\n  stripePublishableKey String? @map(\\\"stripe_publishable_key\\\")\\n  stripeSecretKey      String? @map(\\\"stripe_secret_key\\\")\\n  stripeWebhookSecret  String? @map(\\\"stripe_webhook_secret\\\")\\n\\n  createdAt DateTime @default(now()) @map(\\\"created_at\\\")\\n  updatedAt DateTime @updatedAt @map(\\\"updated_at\\\")\\n\\n  @@map(\\\"settings\\\")\\n}\\n\"\n}\n\nconfig.runtimeDataModel = JSON.parse(\"{\\\"models\\\":{\\\"User\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"email\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"emailVerified\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"email_verified\\\"},{\\\"name\\\":\\\"password\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"name\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"image\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"role\\\",\\\"kind\\\":\\\"enum\\\",\\\"type\\\":\\\"UserRole\\\"},{\\\"name\\\":\\\"avatar\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"lastLogin\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"last_login\\\"},{\\\"name\\\":\\\"createdAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"created_at\\\"},{\\\"name\\\":\\\"updatedAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"updated_at\\\"},{\\\"name\\\":\\\"accounts\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"Account\\\",\\\"relationName\\\":\\\"AccountToUser\\\"},{\\\"name\\\":\\\"sessions\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"Session\\\",\\\"relationName\\\":\\\"SessionToUser\\\"}],\\\"dbName\\\":\\\"users\\\"},\\\"Account\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"userId\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"user_id\\\"},{\\\"name\\\":\\\"type\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"provider\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"providerAccountId\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"provider_account_id\\\"},{\\\"name\\\":\\\"refresh_token\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"access_token\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"expires_at\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"Int\\\"},{\\\"name\\\":\\\"token_type\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"scope\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"id_token\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"session_state\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"user\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"User\\\",\\\"relationName\\\":\\\"AccountToUser\\\"}],\\\"dbName\\\":\\\"accounts\\\"},\\\"Session\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"sessionToken\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"session_token\\\"},{\\\"name\\\":\\\"userId\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"user_id\\\"},{\\\"name\\\":\\\"expires\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\"},{\\\"name\\\":\\\"user\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"User\\\",\\\"relationName\\\":\\\"SessionToUser\\\"}],\\\"dbName\\\":\\\"sessions\\\"},\\\"VerificationToken\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"identifier\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"token\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"expires\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\"}],\\\"dbName\\\":\\\"verification_tokens\\\"},\\\"Category\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"name\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"subtitle\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"description\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"color\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"gradient\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"image\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"productCount\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"Int\\\",\\\"dbName\\\":\\\"product_count\\\"},{\\\"name\\\":\\\"createdAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"created_at\\\"},{\\\"name\\\":\\\"updatedAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"updated_at\\\"},{\\\"name\\\":\\\"metaTitle\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"meta_title\\\"},{\\\"name\\\":\\\"metaDescription\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\",\\\"dbName\\\":\\\"meta_description\\\"},{\\\"name\\\":\\\"products\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"Product\\\",\\\"relationName\\\":\\\"CategoryToProduct\\\"},{\\\"name\\\":\\\"collections\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"CollectionCategory\\\",\\\"relationName\\\":\\\"CategoryToCollectionCategory\\\"}],\\\"dbName\\\":\\\"categories\\\"},\\\"Collection\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"name\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"subtitle\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"description\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"color\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"gradient\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"image\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name\\\":\\\"createdAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"created_at\\\"},{\\\"name\\\":\\\"updatedAt\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"DateTime\\\",\\\"dbName\\\":\\\"updated_at\\\"},{\\\"name\\\":\\\"products\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"CollectionProduct\\\",\\\"relationName\\\":\\\"CollectionToCollectionProduct\\\"},{\\\"name\\\":\\\"categories\\\",\\\"kind\\\":\\\"object\\\",\\\"type\\\":\\\"CollectionCategory\\\",\\\"relationName\\\":\\\"CollectionToCollectionCategory\\\"}],\\\"dbName\\\":\\\"collections\\\"},\\\"Product\\\":{\\\"fields\\\":[{\\\"name\\\":\\\"id\\\",\\\"kind\\\":\\\"scalar\\\",\\\"type\\\":\\\"String\\\"},{\\\"name